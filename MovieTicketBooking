package com.example.movieticketbooking.controller;

import com.example.movieticketbooking.model.MovieTicket;
import com.example.movieticketbooking.repository.MovieTicketRepository;

import jakarta.validation.Valid;

import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/tickets")
public class MovieTicketController {

    private final MovieTicketRepository repository;

    public MovieTicketController(MovieTicketRepository repository) {
        this.repository = repository;
    }

    @PostMapping
    @ResponseStatus(HttpStatus.CREATED)
    public MovieTicket bookTicket(
            @Valid @RequestBody MovieTicket ticket) {

        return repository.save(ticket);
    }

    @GetMapping
    public List<MovieTicket> getAllTickets() {
        return repository.findAll();
    }

    @GetMapping("/{id}")
    public MovieTicket getTicketById(@PathVariable Long id) {
        return repository.findById(id)
                .orElseThrow(() ->
                        new RuntimeException("Ticket not found"));
    }
}

