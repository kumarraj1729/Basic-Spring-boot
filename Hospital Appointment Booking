package com.example.hospitalappointmentbooking.controller;

import com.example.hospitalappointmentbooking.model.HospitalAppointment;
import com.example.hospitalappointmentbooking.repository.HospitalAppointmentRepository;

import jakarta.validation.Valid;

import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/appointments")
public class HospitalAppointmentController {

    private final HospitalAppointmentRepository repository;

    public HospitalAppointmentController(
            HospitalAppointmentRepository repository) {
        this.repository = repository;
    }

    @PostMapping
    @ResponseStatus(HttpStatus.CREATED)
    public HospitalAppointment bookAppointment(
            @Valid @RequestBody HospitalAppointment appointment) {

        return repository.save(appointment);
    }

    @GetMapping
    public List<HospitalAppointment> getAllAppointments() {
        return repository.findAll();
    }

    @GetMapping("/{id}")
    public HospitalAppointment getAppointmentById(
            @PathVariable Long id) {

        return repository.findById(id)
                .orElseThrow(() ->
                        new RuntimeException("Appointment not found"));
    }
}

